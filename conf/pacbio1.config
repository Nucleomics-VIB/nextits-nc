/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running on r730
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run vmikk/nextits -profile $BIOTOOLS/NextITS/conf/pacbio1.config --outdir ...

----------------------------------------------------------------------------------------
*/

// Image from Singularity library
process {
    container = 'library://vmiks/nextits/nextits:1-1-0'
}

params {
    config_profile_name        = 'pacbio1 profile'
    config_profile_description = 'adapted to pacbio1 local resources'

    // Limit resources
    max_cpus   = 80
    max_memory = '192.GB'
    max_time   = '24.h'
}
